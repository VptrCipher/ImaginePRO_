# Optional configuration. No LLM API key is required for the local Codex adapter.
# Environment variables must be exported before starting the backend.
# VIDEO_EDITOR_STORAGE=C:/AI Builder/video-editor/storage
WHISPER_MODEL=base
# FFMPEG_PATH=C:/tools/ffmpeg/bin/ffmpeg.exe
# FFPROBE_PATH=C:/tools/ffmpeg/bin/ffprobe.exe
# CODEX_PATH=C:/path/to/codex.exe
# NODE_BINARY_PATH=C:/Program Files/nodejs/node.exe
# Optional installed browser for the bundled Framecraft Canvas renderer (no browser download).
# FRAMECRAFT_BROWSER_PATH=C:/Program Files/Google/Chrome/Application/chrome.exe
# Additional MANUALLY managed skill roots, separated by ; on Windows or : on Linux.
# VIDEO_EDITOR_SKILL_DIRS=C:/editing-skills
# Optional original ElevenLabs helpers still read ELEVENLABS_API_KEY from .env.
# Separate Enhance Director connection (Pine Labs AgenticOrg).
# AGENTICORG_API_KEY=your-issued-key
# AGENTICORG_BASE_URL=https://agenticorg.hackathon.pinelabs.com
# AGENTICORG_COMPANY_ID=your-company-uuid
# AGENTICORG_AGENT_ID=your-imaginepro-director-agent-uuid
# Windows Settings can store the key using owner-bound DPAPI encryption.
